# ClickHouse HTTP endpoint (8123 for HTTP, commonly 8443 for HTTPS).
CLICKHOUSE_URL=https://clickhouse.example.com:8443
CLICKHOUSE_USER=readonly_backtests
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=analytics
CLICKHOUSE_COMMISSIONS_TABLE=backtest_commissions

# Optional request timeouts.
CLICKHOUSE_CONNECT_TIMEOUT_SECONDS=10
CLICKHOUSE_REQUEST_TIMEOUT_SECONDS=30
